<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="600.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="school.examinations.StudentController">
   <children>
      <VBox styleClass="form-container" spacing="15.0" maxWidth="500.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <Label styleClass="title-label" text="Student Details" />
               <Label fx:id="welcomeLabel" styleClass="subtitle-label" text="Please complete your profile" />
            </VBox>
            
            <HBox spacing="15.0">
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Registration Number" />
                  <TextField fx:id="regNumberField" styleClass="text-field" promptText="Enter Reg Number" />
               </VBox>
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Course" />
                  <TextField fx:id="courseField" styleClass="text-field" promptText="Enter your course" />
               </VBox>
            </HBox>

            <HBox spacing="15.0">
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Year of Study" />
                  <TextField fx:id="yearField" styleClass="text-field" promptText="e.g. 1, 2, 3" />
               </VBox>
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Gender" />
                  <ComboBox fx:id="genderCombo" styleClass="combo-box" promptText="Select Gender" maxWidth="Infinity">
                      <items>
                          <FXCollections fx:factory="observableArrayList">
                              <String fx:value="Male" />
                              <String fx:value="Female" />
                              <String fx:value="Other" />
                          </FXCollections>
                      </items>
                  </ComboBox>
               </VBox>
            </HBox>
            
            <HBox spacing="15.0">
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Date of Birth" />
                  <DatePicker fx:id="dobPicker" styleClass="date-picker" promptText="Select Date" maxWidth="Infinity" />
               </VBox>
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Phone Number" />
                  <TextField fx:id="phoneField" styleClass="text-field" promptText="Enter Phone Number" />
               </VBox>
            </HBox>

            <HBox spacing="15.0">
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Emergency Contact Name" />
                  <TextField fx:id="emerNameField" styleClass="text-field" promptText="Contact Name" />
               </VBox>
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Emergency Contact Phone" />
                  <TextField fx:id="emerPhoneField" styleClass="text-field" promptText="Contact Phone" />
               </VBox>
            </HBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Address" />
               <TextArea fx:id="addressArea" styleClass="text-area" prefRowCount="2" promptText="Enter your physical address" wrapText="true" />
            </VBox>
            
            <Label fx:id="statusLabel" wrapText="true" />

            <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
               <Button fx:id="saveButton" styleClass="button-primary" mnemonicParsing="false" onAction="#handleSave" text="Save Profile Details" prefWidth="200.0" />
            </HBox>

         </children>
      </VBox>
   </children>
</VBox>
