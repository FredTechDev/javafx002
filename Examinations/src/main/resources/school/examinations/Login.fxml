<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="school.examinations.LoginController">
   <children>
      <VBox styleClass="form-container" spacing="15.0" maxWidth="350.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <Label styleClass="title-label" text="Welcome Back" />
               <Label styleClass="subtitle-label" text="Enter username and password to login" />
            </VBox>
            
            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Username" />
               <TextField fx:id="user" styleClass="text-field" promptText="Enter your username" />
            </VBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Password" />
               <PasswordField fx:id="pass" styleClass="password-field" promptText="Enter your password" />
               <Label fx:id="error" wrapText="true" />
            </VBox>

            <HBox alignment="CENTER" spacing="15.0">
               <Button fx:id="cancel" styleClass="button-secondary" mnemonicParsing="false" onAction="#handleCancel" text="Cancel" prefWidth="100.0" />
               <Button fx:id="login" styleClass="button-primary" mnemonicParsing="false" onAction="#handleLogin" text="Login" prefWidth="100.0" />
            </HBox>

            <HBox alignment="CENTER">
               <Label text="Don't have an account?" textFill="#64748b" />
               <Hyperlink fx:id="register1" styleClass="hyperlink" onAction="#handleRegister" text="Register" />
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
