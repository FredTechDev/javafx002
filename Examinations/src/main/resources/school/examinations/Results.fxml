<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="600.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="school.examinations.ResultsController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <VBox styleClass="form-container" spacing="15.0" VBox.vgrow="ALWAYS" maxWidth="800.0">
         <children>
            <VBox spacing="5.0">
               <Label styleClass="title-label" text="My Results" />
               <Label fx:id="studentNameLabel" styleClass="subtitle-label" text="Academic Record" />
            </VBox>
            
            <TableView fx:id="resultsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="codeColumn" prefWidth="120.0" text="Unit Code" />
                <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Unit Name" />
                <TableColumn fx:id="scoreColumn" prefWidth="100.0" text="Score (%)" />
                <TableColumn fx:id="gradeColumn" prefWidth="100.0" text="Grade" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
