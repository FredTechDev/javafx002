<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="450.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="school.examinations.RegisterController">
   <children>
      <VBox styleClass="form-container" spacing="15.0" maxWidth="400.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <Label styleClass="title-label" text="Create Account" />
               <Label styleClass="subtitle-label" text="Enter your details to register" />
            </VBox>
            
            <HBox spacing="10.0">
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="First Name" />
                  <TextField fx:id="fname" styleClass="text-field" promptText="First name" />
               </VBox>
               <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label styleClass="field-label" text="Last Name" />
                  <TextField fx:id="lname" styleClass="text-field" promptText="Last name" />
               </VBox>
            </HBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Email" />
               <TextField fx:id="email" styleClass="text-field" promptText="Enter email" />
               <Label fx:id="emailError" wrapText="true" />
            </VBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Username" />
               <TextField fx:id="username" styleClass="text-field" promptText="Choose a username" />
            </VBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Password" />
               <PasswordField fx:id="password" styleClass="password-field" promptText="Enter password" />
            </VBox>

            <VBox spacing="5.0">
               <Label styleClass="field-label" text="Confirm Password" />
               <PasswordField fx:id="confirm" styleClass="password-field" promptText="Confirm password" />
            </VBox>

            <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
               <Button fx:id="cancel" styleClass="button-secondary" mnemonicParsing="false" text="Cancel" prefWidth="120.0" />
               <Button fx:id="register" styleClass="button-primary" mnemonicParsing="false" onAction="#handleRegister" text="Register" prefWidth="120.0" />
            </HBox>

         </children>
      </VBox>
   </children>
</VBox>
